<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/lang_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btn_ko"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/flag_ko"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_lang_button"
            android:clipToOutline="true"
            android:contentDescription="한국어" />

        <ImageButton
            android:id="@+id/btn_en"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/flag_en"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_lang_button"
            android:clipToOutline="true"
            android:contentDescription="English" />

        <ImageButton
            android:id="@+id/btn_ja"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/flag_ja"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_lang_button"
            android:clipToOutline="true"
            android:contentDescription="日本語" />

        <ImageButton
            android:id="@+id/btn_zh"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/flag_zh"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_lang_button"
            android:clipToOutline="true"
            android:contentDescription="中文" />

    </LinearLayout>

</FrameLayout>
